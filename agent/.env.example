# Port the agent listens on — must match the node's port registered in the panel
AGENT_PORT=4200

# Shared secret — the panel sends this in the "x-agent-key" header.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AGENT_API_KEY=

# Where bot folders live on THIS VPS (created by setup-agent.sh)
BOTS_ROOT_DIR=/root/bots

# Where website folders live (defaults to BOTS_ROOT_DIR if unset)
SITES_ROOT_DIR=/root/sites

# PM2 process name of the agent itself (used for self-restart/update/logs)
AGENT_PM2_NAME=panel-agent

# Absolute paths OUTSIDE the two roots above that this agent may still manage,
# comma separated. Needed for projects registered from an existing folder
# (source="local") — e.g. an ArnTo bot living in /home/khaidev/arnto.
# This is an allowlist, not a bypass: anything not under one of these (or under
# BOTS_ROOT_DIR / SITES_ROOT_DIR) is refused. Leave empty for none.
EXTRA_ROOTS=

# Address the agent binds to. Default 0.0.0.0.
# Do NOT set 127.0.0.1 on a node other machines reach for its CONNECT proxy or
# for panel control traffic — only on a node that exclusively serves a panel
# running on the same machine.
AGENT_BIND=0.0.0.0

# ── Panel self-management (only on the node that runs the panel) ──────────────
# Absolute path to the panel repo. Enables /self/env, /self/panel-* and
# /self/rebuild-app so the panel never has to run a shell command itself.
# These endpoints work on this fixed path only — they take no path parameter.
PANEL_DIR=
# PM2 process name of the panel
PANEL_PM2_NAME=bot-panel
