# ─────────────────────────────────────────────
#  Bot Panel — Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=production

# Panel credentials — this is the panel's ONLY account. There is no users table,
# no roles and no registration; changing the password means regenerating the hash
# below and restarting the panel.
ADMIN_USERNAME=admin
# Generate hash: node -e "const b=require('bcryptjs');console.log(b.hashSync('yourpassword',10))"
ADMIN_PASSWORD_HASH=$2a$10$examplehashedpasswordhere

# JWT secret — generate a strong random string. Also encrypts the stored copy of
# every project API key: changing it means creating those keys again.
JWT_SECRET=changeme_very_long_random_secret_here

# ── Which node runs this panel ────────────────────────────────────────────────
# _id of the node record for the machine this panel runs on. REQUIRED: the panel
# is a control plane and reaches even its own machine through that node's agent.
# Find it on the Nodes page, or with:
#   node -e "const D=require('better-sqlite3');const d=new D('data/panel.sqlite',{readonly:true});console.log(JSON.parse(d.prepare(\"SELECT json FROM json WHERE ID='nodes'\").get().json).map(n=>n._id+'  '+n.name).join('\n'))"
# It also doubles as the default placement for websites and services.
# Moving the panel (Panel page → Move Panel) rewrites this for you.
PANEL_NODE_ID=

# Repo a node added with the one-command setup (Systems → Add node) clones.
# Empty = this checkout's origin as a public https URL (a new VPS has no SSH key).
# NODE_JOIN_REPO_URL=https://github.com/khaiclone/panel.git

# ── Talking to the bots ──────────────────────────────────────────────────────
# Bots call the panel (shared data, /api/external/*) with their OWN key, created
# under Panel Settings → API Keys. The panel never calls a bot: commands go over a
# private Discord channel, posted by the panel's own Discord bot.
PANEL_DISCORD_TOKEN=
PANEL_BUS_CHANNEL_ID=
# Optional legacy shared key for /api/external/* (not for shared data). Leave
# empty unless an old client still needs it.
PANEL_API_KEY=

# ── Discord — Admin/Alert Notifications ──────
# Webhook for expiry warnings and removal alerts
DISCORD_ALERT_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy

# Webhook for hourly DB backups (panel.sqlite + shared.sqlite.gz)
DISCORD_BACKUP_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy

# Webhook for the daily Lavalink release check (02:00 Asia/Ho_Chi_Minh).
# Only sends when something actually happened — an update ran, or one failed.
# Falls back to DISCORD_ALERT_WEBHOOK when left blank.
DISCORD_LAVALINK_WEBHOOK=

# ── Public decor site (static, e.g. on Vercel) ───────────────────────────────
# The panel commits data/decors.json + data/categories.json to the site's repo a
# minute after the shared decor data changes. Token: fine-grained, Contents
# read & write on that one repo. Empty = off.
DECOR_SITE_GITHUB_TOKEN=
DECOR_SITE_REPO=KhaiClone/decor-site
DECOR_SITE_BRANCH=master

# ── Auto Quest / Auto Badge ──────────────────────────────────────────────────
# Encrypts stored Discord tokens (quests, badge readers, proxies) — 64 hex chars.
QUEST_ENC_SECRET=
# Monthly plans: run hour (Tue/Sat) and daily enroll-scan hour, server time.
MONTHLY_RUN_HOUR=9
MONTHLY_ENROLL_HOUR=3
# =1 de dinh tuyen reader qua proxy pool. Mac dinh tat: mot acc ca nhan co IP on
# dinh la binh thuong, IP nhay giua cac proxy moi giong bot.
BADGE_READER_USE_PROXY=0

# ── Development only ─────────────────────────
# Vite dev server allowed by CORS when NODE_ENV is not production.
# CLIENT_URL=http://localhost:5173
